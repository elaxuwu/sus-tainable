{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"sus-tainable-factory",
  "main":"server/factory.js",
  "compatibility_date":"2026-10-07",
  "workers_dev":false,
  "observability":{"enabled":true},
  "vars":{
    "ONEENDPOINT_BASE_URL":"https://1endpoint.dev/api/v1",
    "IMAGE_MODEL":"gpt-image-2",
    "TEXT_MODEL":"deepseek-v4.1-flash"
  },
  "ratelimits":[{"name":"CASE_RATE_LIMITER","namespace_id":"1001","simple":{"limit":6,"period":60}}]
}
